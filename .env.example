# ============================================================
# Common
# ============================================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================================
# NestJS Backend
# ============================================================
BACKEND_PORT=3000
JWT_SECRET=your-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# ============================================================
# Agent Service (Python / FastAPI)
# ============================================================
AGENT_SERVICE_PORT=8000
AGENT_SERVICE_HOST=0.0.0.0

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=1536

# ============================================================
# Milvus
# ============================================================
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=bga_

# ============================================================
# Neo4j
# ============================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-change-me
NEO4J_DATABASE=neo4j

# ============================================================
# Redis
# ============================================================
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_PASSWORD=

# ============================================================
# MinIO (S3-compatible object storage)
# ============================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=business-guide-agent
MINIO_USE_SSL=false

# ============================================================
# PostgreSQL (NestJS main DB)
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-change-me
POSTGRES_DB=business_guide_agent

# ============================================================
# Agent Service URL (used by Backend to call Agent)
# ============================================================
AGENT_SERVICE_URL=http://agent-service:8000

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Frontend (Vite dev)
# ============================================================
VITE_API_URL=http://localhost:3000
VITE_PROJECT_ID=demo-project